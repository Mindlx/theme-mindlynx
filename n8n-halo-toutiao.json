{
  "name": "Halo → 多平台同步管道",
  "nodes": [
    {
      "parameters": { "url": "https://www.mindlynx.top/feed.xml" },
      "id": "rss-read", "name": "RSS 读取", "type": "n8n-nodes-base.rssFeedRead",
      "position": [250, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {"name": "title", "value": "={{ $json.title }}"},
            {"name": "content", "value": "={{ $json.content }}"},
            {"name": "link", "value": "={{ $json.link }}"},
            {"name": "pubDate", "value": "={{ $json.isoDate }}"}
          ]
        }
      },
      "id": "filter", "name": "提取字段", "type": "n8n-nodes-base.set",
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet content = item.content;\n// Strip Markdown\ncontent = content.replace(/!\\[.*?\\]\\(.*?\\)/g, '');\ncontent = content.replace(/```[\\s\\S]*?```/g, '');\ncontent = content.replace(/`([^`]+)`/g, '$1');\ncontent = content.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\ncontent = content.replace(/^### /gm, '<h3>');\ncontent = content.replace(/^## /gm, '<h2>');\ncontent = content.replace(/^# /gm, '<h1>');\ncontent = content.replace(/\\[(.*?)\\]\\(.*?\\)/g, '$1');\ncontent = content.replace(/\\|.*?\\|/g, '');\ncontent = content.replace(/\\n{3,}/g, '\\n\\n');\nconst source = `<p><a href=\"${item.link}\">—— 原文链接</a></p>`;\nreturn { title: item.title, content: content + source, link: item.link };"
      },
      "id": "convert", "name": "Markdown→HTML", "type": "n8n-nodes-base.code",
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.weixin.qq.com/cgi-bin/draft/add",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "access_token", "value": "={{ $node['微信Token'].json.access_token }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "articles[0].title", "value": "={{ $json.title }}"},
            {"name": "articles[0].content", "value": "={{ $json.content }}"},
            {"name": "articles[0].content_source_url", "value": "={{ $json.link }}"},
            {"name": "articles[0].need_open_comment", "value": "0"},
            {"name": "articles[0].only_fans_can_comment", "value": "0"}
          ]
        }
      },
      "id": "wechat-draft", "name": "微信→存草稿", "type": "n8n-nodes-base.httpRequest",
      "position": [850, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.weixin.qq.com/cgi-bin/token",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "grant_type", "value": "client_credential"},
            {"name": "appid", "value": "wxf0eaaf78e769d277"},
			{"name": "secret", "value": "afb8450d388c9e7c5a9e441225b22f54"}
          ]
        }
      },
      "id": "wechat-token", "name": "微信Token", "type": "n8n-nodes-base.httpRequest",
      "position": [650, 100]
    }
  ],
  "connections": {
    "RSS 读取": {"main": [[{"node": "提取字段", "type": "main", "index": 0}]]},
    "提取字段": {"main": [[{"node": "Markdown→HTML", "type": "main", "index": 0}]]},
    "Markdown→HTML": {"main": [[{"node": "微信→存草稿", "type": "main", "index": 0}]]},
    "微信Token": {"main": [[{"node": "微信→存草稿", "type": "main", "index": 1}]]}
  }
}
